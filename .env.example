# ---------------------------------------------------------------------------
# Gitanjali Schools · Asset Register
# Copy this file to `.env.local` and adjust as needed. Everything here is
# optional — the app runs out of the box with the bundled Excel snapshot.
# ---------------------------------------------------------------------------

# Admin account (defaults are used when these are not set)
# ADMIN_EMAIL=admin@gitanjalischools.com
# ADMIN_PASSWORD=admin123

# Secret used to sign the session cookie. Set a long random value in production.
# AUTH_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Google Sheets (optional)
# When GOOGLE_SHEET_ID is present the app reads live rows from the shared
# spreadsheet instead of the bundled JSON snapshot.
#
# Setup:
#   1. Share the sheet as "Anyone with the link → Viewer".
#   2. Copy the id from the URL:
#      https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
#   3. Set the tab name if it is not "Sheet1".
# ---------------------------------------------------------------------------
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_NAME=Sheet1

# Full CSV endpoint override (takes precedence over the two values above).
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<id>/gviz/tq?tqx=out:csv&sheet=Sheet1

# How often (seconds) live sheet data is re-fetched.
# SHEET_REVALIDATE_SECONDS=300
